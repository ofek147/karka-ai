# ─── AI ───────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ─── Email (Resend.com) ────────────────────────────────────────────────────────
# Get key at: https://resend.com/api-keys
# Domain must be verified: karka-ai.co.il
RESEND_API_KEY=re_...

# ─── Database ─────────────────────────────────────────────────────────────────
# Railway provides this automatically when Postgres addon is added.
# Local dev: leave empty → SQLite fallback
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ─── Redis ────────────────────────────────────────────────────────────────────
# Railway provides this automatically when Redis addon is added.
REDIS_URL=redis://localhost:6379

# ─── govmap ───────────────────────────────────────────────────────────────────
# Register at: https://govmap.gov.il/developer
# Domain must be registered as: karka-ai.co.il
GOVMAP_TOKEN=
GOVMAP_DOMAIN=karka-ai.co.il

# ─── App ──────────────────────────────────────────────────────────────────────
MOCK_MODE=false
CACHE_TTL_SECONDS=86400
FRONTEND_URL=https://karka-ai.co.il
