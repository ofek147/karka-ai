# Anthropic (required)
ANTHROPIC_API_KEY=sk-ant-...

# govmap — register at https://govmap.gov.il/developer
# Domain must be registered as: karka-ai.co.il
GOVMAP_TOKEN=
GOVMAP_DOMAIN=karka-ai.co.il

# Postgres — Railway provides this automatically as $DATABASE_URL
# Local dev: leave empty → SQLite fallback (data/karka.db)
DATABASE_URL=

# Redis — Railway provides this automatically as $REDIS_URL
REDIS_URL=redis://localhost:6379

# App
MOCK_MODE=false
CACHE_TTL_SECONDS=86400
