<!DOCTYPE html>
<html dir="rtl" lang="he">
<head>
<meta charset="UTF-8">
<title>דוח תכנוני — גוש {{ gush }} חלקה {{ helka }}</title>
<style>
@font-face {
  font-family: 'Heebo';
  font-style: normal;
  font-weight: 300;
  src: url('data:font/truetype;base64,') format('truetype');
}
@font-face {
  font-family: 'Heebo';
  font-style: normal;
  font-weight: 400;
  src: url('data:font/truetype;base64,') format('truetype');
}
@font-face {
  font-family: 'Heebo';
  font-style: normal;
  font-weight: 700;
  src: url('data:font/truetype;base64,') format('truetype');
}
@font-face {
  font-family: 'Cormorant Garamond';
  font-style: normal;
  font-weight: 400;
  src: url('data:font/truetype;base64,') format('truetype');
}
@font-face {
  font-family: 'Cormorant Garamond';
  font-style: normal;
  font-weight: 500;
  src: url('data:font/truetype;base64,') format('truetype');
}
@font-face {
  font-family: 'Cormorant Garamond';
  font-style: italic;
  font-weight: 400;
  src: url('data:font/truetype;base64,') format('truetype');
}
@font-face {
  font-family: 'Cormorant Garamond';
  font-style: italic;
  font-weight: 500;
  src: url('data:font/truetype;base64,') format('truetype');
}
@font-face {
  font-family: 'Montserrat';
  font-style: normal;
  font-weight: 300;
  src: url('data:font/truetype;base64,') format('truetype');
}
@font-face {
  font-family: 'Montserrat';
  font-style: normal;
  font-weight: 400;
  src: url('data:font/truetype;base64,') format('truetype');
}
</style>
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0;}
:root{
  --green-900:#141F19;
  --green-800:#1C2B23;
  --cream:#F2EBDD;
  --ivory:#EDE7DA;
  --muted:#B8B0A0;
  --body-warm:#6B6355;
  --gold:#C9A24B;
  --gold-soft:#BFA468;
  --white:#FFFFFF;
  --footer-h:28px;
  --content-h:calc(210mm - 28px);
}
body{font-family:'Heebo',sans-serif;font-size:13px;line-height:1.6;background:#fff;direction:rtl;}
@page{size:297mm 210mm;margin:0;}
.slide{width:297mm;height:210mm;page-break-after:always;overflow:hidden;position:relative;}
.slide:last-child{page-break-after:avoid;}

/* ── Shared ── */
.micro    {font-family:'Montserrat',sans-serif;font-weight:300;font-size:9px;letter-spacing:.32em;text-transform:uppercase;color:var(--gold);}
.micro-dk {font-family:'Montserrat',sans-serif;font-weight:300;font-size:9px;letter-spacing:.32em;text-transform:uppercase;color:var(--green-800);}
.hl       {width:44px;height:1px;background:var(--gold);margin:6px 0 12px;}
.badge    {display:inline-block;border-radius:3px;padding:1px 6px;font-family:'Montserrat',sans-serif;
           font-weight:300;font-size:8px;line-height:1.6;white-space:nowrap;
           max-width:150px;overflow:hidden;text-overflow:ellipsis;}
.b-local   {border:1px solid rgba(201,162,75,.5); color:var(--gold-soft);background:rgba(201,162,75,.06);}
.b-district{border:1px solid rgba(184,176,160,.4);color:var(--muted);   background:rgba(255,255,255,.04);}
.b-national{border:1px solid rgba(184,176,160,.3);color:var(--muted);   background:rgba(255,255,255,.03);}
.b-approved{border:1px solid var(--gold);         color:var(--gold);    background:rgba(201,162,75,.15);}
.b-deposit {border:1px solid rgba(237,231,218,.3);color:var(--ivory);   background:rgba(255,255,255,.10);}
.b-other   {border:1px solid rgba(184,176,160,.3);color:var(--muted);   background:rgba(255,255,255,.06);}

.sfooter{position:absolute;bottom:0;left:0;right:0;height:var(--footer-h);
  display:flex;justify-content:space-between;align-items:center;padding:0 26px;z-index:10;}
.sfooter-dk{background:var(--green-900);border-top:1px solid rgba(201,162,75,.15);}
.sfooter-lt{background:var(--cream);border-top:1px solid rgba(28,43,35,.10);}
.flogo   {font-family:'Cormorant Garamond',serif;font-style:italic;font-size:14px;color:var(--ivory);}
.flogo-dk{font-family:'Cormorant Garamond',serif;font-style:italic;font-size:14px;color:var(--green-800);}
.flogo .ga,.flogo-dk .ga{color:var(--gold);}
.fdate{font-family:'Montserrat',sans-serif;font-weight:300;font-size:8px;letter-spacing:.1em;color:var(--muted);}
.vdivider{position:absolute;top:16px;width:1px;height:calc(var(--content-h) - 32px);z-index:1;}
.vd-gold{background:rgba(201,162,75,.2);}
.vd-dark{background:rgba(28,43,35,.12);}

/* ══ SLIDE 1: COVER ══ */
#slide-cover{background:var(--green-900);}
.cov-sat{position:absolute;top:0;right:0;width:60%;height:100%;z-index:1;overflow:hidden;}
.cov-sat img{width:100%;height:100%;object-fit:cover;object-position:center;}
.cov-sat-fade{position:absolute;top:0;left:0;width:120px;height:100%;
  background:linear-gradient(to right,var(--green-900) 0%,transparent 100%);}
.cov-sat-poly{position:absolute;top:0;left:0;width:100%;height:100%;}
.cov-left{position:absolute;top:0;left:0;width:43%;height:var(--content-h);z-index:3;
  display:flex;flex-direction:column;justify-content:center;
  padding:0 8mm 0 12mm;text-align:right;direction:rtl;overflow:hidden;}
.cov-label{font-family:'Montserrat',sans-serif;font-weight:300;font-size:9px;
  letter-spacing:.32em;text-transform:uppercase;color:var(--gold);margin-bottom:6px;}
.cov-hl{width:44px;height:1px;background:var(--gold);margin-bottom:10px;}
.cov-city{font-family:'Cormorant Garamond',serif;font-style:italic;
  font-size:44px;color:var(--ivory);line-height:1.05;
  white-space:nowrap;overflow:hidden;text-overflow:ellipsis;
  max-width:100%;margin-bottom:5mm;}
.cov-gush{font-family:'Heebo',sans-serif;font-weight:300;font-size:12px;
  color:var(--ivory);opacity:.82;line-height:2;margin-bottom:7mm;}
.cov-box{border:1px solid rgba(201,162,75,.3);border-right:2px solid var(--gold);
  border-radius:4px;padding:8px 12px;}
.cov-box-lbl{font-family:'Montserrat',sans-serif;font-weight:300;font-size:8px;
  letter-spacing:.18em;text-transform:uppercase;color:var(--muted);margin-bottom:2px;}
.cov-box-val{font-family:'Cormorant Garamond',serif;font-size:24px;color:var(--ivory);line-height:1.1;}
.cov-box-sub{font-family:'Heebo',sans-serif;font-weight:300;font-size:9px;color:var(--muted);margin-top:2px;}
.cov-top-logo{position:absolute;top:10px;right:16px;z-index:4;
  font-family:'Cormorant Garamond',serif;font-style:italic;font-size:16px;color:var(--ivory);}
.cov-top-logo .ga{color:var(--gold);}

/* ══ SLIDE 2: LAND USE ══ */
#slide-land-use{background:var(--cream);}
.lu-left{position:absolute;top:0;left:0;width:42%;height:var(--content-h);
  padding:22px 12px 16px 28px;direction:rtl;text-align:right;overflow:hidden;}
.lu-right{position:absolute;top:0;right:0;width:57%;height:var(--content-h);
  padding:22px 28px 16px 12px;direction:rtl;text-align:right;overflow:hidden;}
.lu-page-title{font-family:'Cormorant Garamond',serif;font-weight:500;
  font-size:32px;color:var(--green-800);line-height:1.1;margin-bottom:10px;}
.lu-yiud{font-family:'Cormorant Garamond',serif;font-weight:500;
  font-size:22px;color:var(--green-800);line-height:1.2;margin-bottom:3px;}
.lu-desc{font-family:'Heebo',sans-serif;font-weight:300;
  font-size:10px;color:var(--body-warm);line-height:1.6;margin-bottom:6px;}
.lu-pill{display:inline-block;border:1px solid var(--gold);border-radius:20px;
  padding:2px 9px;font-family:'Heebo',sans-serif;font-weight:300;font-size:9px;color:var(--body-warm);}
.lu-extra{margin-top:6px;display:flex;flex-wrap:wrap;gap:4px;}
.lu-sec{padding-bottom:12px;}
.lu-sec+.lu-sec{border-top:1px solid rgba(28,43,35,.1);padding-top:12px;}
.lu-sec-title{font-family:'Cormorant Garamond',serif;font-weight:500;
  font-size:16px;color:var(--green-800);margin-bottom:2px;
  white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
.lu-plan-num{font-family:'Heebo',sans-serif;font-weight:300;
  font-size:9px;color:var(--muted);margin-bottom:3px;}
.lu-plan-obj{font-family:'Heebo',sans-serif;font-weight:300;
  font-size:10px;color:var(--body-warm);line-height:1.5;max-height:48px;overflow:hidden;}
.lu-no-data{font-family:'Heebo',sans-serif;font-weight:300;font-size:10px;color:var(--muted);}

/* ══ SLIDE 3: PLANS ══ */
#slide-plans{background:var(--green-900);direction:rtl;}
.pl-left{position:absolute;top:0;left:0;width:26%;height:var(--content-h);
  padding:22px 8px 16px 28px;display:flex;flex-direction:column;
  direction:rtl;text-align:right;overflow:hidden;}
.pl-right{position:absolute;top:0;right:0;width:73%;height:var(--content-h);
  padding:22px 28px 16px 12px;direction:rtl;overflow:hidden;}
.pl-count{font-family:'Cormorant Garamond',serif;font-weight:300;font-style:italic;
  font-size:56px;color:var(--ivory);line-height:1;}
.pl-sub{font-family:'Heebo',sans-serif;font-weight:300;font-size:10px;color:var(--muted);margin-top:4px;}
.pl-grid{display:grid;grid-template-columns:1fr 1fr;gap:0 16px;}
.pl-item{border-bottom:1px solid rgba(201,162,75,.1);padding:6px 0;}
.pl-name{font-family:'Heebo',sans-serif;font-weight:400;font-size:10px;color:var(--ivory);
  white-space:nowrap;overflow:hidden;text-overflow:ellipsis;margin-bottom:1px;}
.pl-meta{font-family:'Heebo',sans-serif;font-weight:300;font-size:8px;color:var(--muted);margin-bottom:2px;}
.pl-badges{display:flex;gap:3px;flex-wrap:nowrap;overflow:hidden;}
.pl-more{margin-top:6px;text-align:center;font-family:'Heebo',sans-serif;
  font-weight:300;font-size:9px;color:var(--muted);}

/* ══ SLIDE 4: MARKET ══ */
#slide-market{background:var(--green-900);direction:rtl;}
.mkt-left{position:absolute;top:0;left:0;width:42%;height:var(--content-h);
  padding:22px 12px 16px 28px;display:flex;flex-direction:column;
  direction:rtl;text-align:right;overflow:hidden;}
.mkt-right{position:absolute;top:0;right:0;width:57%;height:var(--content-h);
  padding:22px 28px 16px 14px;direction:rtl;background:var(--green-800);overflow:hidden;
  display:flex;flex-direction:column;}
.mkt-title{font-family:'Cormorant Garamond',serif;font-weight:300;font-style:italic;
  font-size:40px;color:var(--ivory);line-height:1;}
.mkt-stat{border-bottom:1px solid rgba(201,162,75,.12);padding:9px 0;}
.mkt-stat.last{border-bottom:none;padding-bottom:0;}
.mkt-lbl{font-family:'Heebo',sans-serif;font-weight:300;font-size:9px;color:var(--gold);margin-bottom:1px;}
.mkt-val{font-family:'Cormorant Garamond',serif;font-size:30px;color:var(--ivory);line-height:1;
  direction:ltr;display:inline-block;}
.mkt-sub{font-family:'Heebo',sans-serif;font-weight:300;font-size:8px;color:var(--muted);margin-top:1px;}
.mkt-trend{margin-top:auto;background:rgba(255,255,255,.05);border-right:2px solid var(--gold);
  border-radius:3px;padding:10px 14px;}
.trend-num{font-family:'Cormorant Garamond',serif;font-size:26px;line-height:1;}
.trend-up  {color:var(--gold);}
.trend-down{color:var(--muted);}
.trend-flat{color:var(--muted);}
.trend-lbl{font-family:'Heebo',sans-serif;font-weight:300;font-size:9px;color:var(--muted);margin-top:2px;}
.mkt-compare-title{font-family:'Cormorant Garamond',serif;font-weight:500;
  font-size:20px;color:var(--ivory);margin-bottom:8px;}
.mkt-table{width:100%;border-collapse:collapse;font-size:10px;font-family:'Heebo',sans-serif;direction:rtl;}
.mkt-table th{background:rgba(0,0,0,.25);color:var(--ivory);padding:6px 8px;
  text-align:right;font-weight:400;font-size:9px;white-space:nowrap;}
.mkt-table td{padding:6px 8px;text-align:right;color:var(--ivory);
  border-bottom:1px solid rgba(201,162,75,.08);}
.mkt-table tr:nth-child(even) td{background:rgba(255,255,255,.03);}
.mkt-null{color:var(--muted);}
.mkt-note{font-family:'Heebo',sans-serif;font-weight:300;font-size:9px;color:var(--muted);
  padding-top:10px;margin-top:auto;}

/* ══ SLIDE 5: AI ══ */
#slide-ai{background:var(--cream);direction:rtl;}
.ai-inner{position:absolute;top:0;left:0;right:0;height:var(--content-h);
  padding:24px 36px 16px 36px;display:flex;flex-direction:column;}
.ai-page-title{font-family:'Cormorant Garamond',serif;font-style:italic;font-weight:400;
  font-size:38px;color:var(--green-800);line-height:1.1;}
.ai-page-title .ga{color:var(--gold);}
.ai-subtitle{font-family:'Heebo',sans-serif;font-weight:300;font-size:11px;
  color:var(--body-warm);margin-top:4px;margin-bottom:12px;}
.ai-box{flex:1;background:var(--white);border:1px solid rgba(201,162,75,.3);
  border-right:2px solid var(--gold);border-radius:5px;
  padding:18px 22px;margin-bottom:10px;overflow:hidden;}
.ai-box-micro{margin-bottom:4px;}
.ai-box-hl{width:44px;height:1px;background:var(--gold);margin-bottom:10px;}
.ai-text{font-family:'Heebo',sans-serif;font-weight:400;font-size:13px;
  color:var(--green-800);line-height:1.85;}
.ai-disclaimer{background:rgba(201,162,75,.07);border:1px solid rgba(201,162,75,.2);
  border-radius:4px;padding:10px 14px;}
.ai-disclaimer-text{font-family:'Heebo',sans-serif;font-weight:300;
  font-size:9px;color:var(--body-warm);line-height:1.7;}
</style>
</head>
<body>

<!-- ══ SLIDE 1: COVER ══ -->
<div class="slide" id="slide-cover">
  <svg style="position:absolute;top:0;left:0;width:100%;height:100%;z-index:0;"
       viewBox="0 0 1123 794" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
    <polygon points="0,0 450,0 500,794 0,794" fill="#141F19"/>
    <polygon points="430,0 450,0 500,794 480,794" fill="rgba(201,162,75,0.07)"/>
  </svg>

  {% if satellite_b64 %}
  <div class="cov-sat">
    <img src="data:image/png;base64,{{ satellite_b64 }}" alt="">
    {% if shape_wkt_pixels %}
    <svg class="cov-sat-poly" viewBox="0 0 1200 800" preserveAspectRatio="none">
      <polygon points="{{ shape_wkt_pixels }}"
               fill="rgba(201,162,75,0.15)" stroke="#C9A24B" stroke-width="3"/>
    </svg>
    {% endif %}
    <div class="cov-sat-fade"></div>
  </div>
  {% endif %}

  <div class="cov-left">
    <div class="cov-label">דוח תכנוני</div>
    <div class="cov-hl"></div>
    <div class="cov-city">{% if city %}{{ city }}{% else %}גוש {{ gush }}{% endif %}</div>
    <div class="cov-gush">גוש {{ gush }} · חלקה {{ helka }}</div>
    {% if area_sqm %}
    <div class="cov-box">
      <div class="cov-box-lbl">שטח החלקה</div>
      <div class="cov-box-val">{{ "{:,.0f}".format(area_sqm) }} מ"ר</div>
      <div class="cov-box-sub">{{ "{:.2f}".format(area_dunam) }} דונם</div>
    </div>
    {% endif %}
  </div>

  <div class="cov-top-logo">kark<span class="ga">A</span>i</div>

  <div class="sfooter sfooter-dk">
    <div class="flogo">kark<span class="ga">A</span>i</div>
    <div class="fdate">{{ created_at }}</div>
  </div>
</div>


<!-- ══ SLIDE 2: LAND USE ══ -->
<div class="slide" id="slide-land-use">
  <div class="vdivider vd-dark" style="left:42%;"></div>

  <div class="lu-left">
    <div class="micro-dk">ייעודי קרקע</div>
    <div class="hl" style="background:var(--green-800);"></div>
    <div class="lu-page-title">נתוני החלקה</div>

    {% if land_use_items %}
      {% set main_lu = land_use_items[0] %}
      <div style="margin-top:12px;">
        <div class="lu-yiud">{{ main_lu.yiud }}</div>
        {% if main_lu.yiud_explained %}<div class="lu-desc">{{ main_lu.yiud_explained }}</div>{% endif %}
        {% if main_lu.area_dunam %}<span class="lu-pill">{{ main_lu.area_dunam }} דונם</span>
        {% elif area_dunam %}<span class="lu-pill">{{ area_dunam }} דונם</span>{% endif %}
        {% if land_use_items|length > 1 %}
        <div class="lu-extra">
          {% for lu in land_use_items[1:4] %}
          <span class="lu-pill">{{ lu.yiud }}{% if lu.area_dunam %} · {{ lu.area_dunam }} ד'{% endif %}</span>
          {% endfor %}
        </div>
        {% endif %}
      </div>
    {% else %}
      <div class="lu-no-data" style="margin-top:12px;">לא נמצאו נתוני ייעוד</div>
    {% endif %}
  </div>

  <div class="lu-right">
    {% set local_plans = plans | selectattr("plan_type_order","eq",1) | list %}
    {% set higher_plans = plans | selectattr("plan_type_order","ne",1) | sort(attribute="plan_type_order") | list %}

    <div class="lu-sec">
      <div class="micro" style="color:var(--green-800);opacity:.7;">תכנית מקומית</div>
      <div class="hl" style="background:var(--green-800);opacity:.35;"></div>
      {% if local_plans %}
        {% set lp = local_plans[0] %}
        <div class="lu-sec-title">{{ lp.pl_name or lp.mavat_name }}</div>
        <div class="lu-plan-num">{{ lp.pl_number }}{% if lp.date_display %} · {{ lp.date_display }}{% endif %}{% if lp.status_display %} · {{ lp.status_display }}{% endif %}</div>
        {% if lp.pl_objectives %}<div class="lu-plan-obj">{{ lp.pl_objectives[:220] }}{% if lp.pl_objectives|length > 220 %}…{% endif %}</div>{% endif %}
      {% else %}
        <div class="lu-no-data">לא נמצאה תכנית מקומית</div>
      {% endif %}
    </div>

    <div class="lu-sec">
      <div class="micro" style="color:var(--muted);">תכנית ארצית / מחוזית</div>
      <div class="hl" style="background:var(--muted);opacity:.4;"></div>
      {% if higher_plans %}
        {% set hp = higher_plans[0] %}
        <div class="lu-sec-title" style="color:var(--body-warm);">{{ hp.pl_name or hp.mavat_name }}</div>
        <div class="lu-plan-num">{{ hp.pl_number }}{% if hp.date_display %} · {{ hp.date_display }}{% endif %}{% if hp.status_display %} · {{ hp.status_display }}{% endif %}</div>
        {% if hp.pl_objectives %}<div class="lu-plan-obj">{{ hp.pl_objectives[:220] }}{% if hp.pl_objectives|length > 220 %}…{% endif %}</div>{% endif %}
      {% else %}
        <div class="lu-no-data">לא נמצאה תכנית ארצית / מחוזית</div>
      {% endif %}
    </div>
  </div>

  <div class="sfooter sfooter-lt">
    <div class="flogo-dk">kark<span class="ga">A</span>i</div>
    <div class="fdate" style="color:var(--body-warm);">{{ created_at }}</div>
  </div>
</div>


<!-- ══ SLIDE 3: PLANS ══ -->
<div class="slide" id="slide-plans">
  <div class="vdivider vd-gold" style="left:26%;"></div>

  <div class="pl-left">
    <div class="micro">תכניות בנייה</div>
    <div class="hl"></div>
    <div class="pl-count">{{ plans|length }}</div>
    <div class="pl-sub">תכניות בנייה<br>רלוונטיות לחלקה</div>
  </div>

  <div class="pl-right">
    {% set display_plans = plans[:14] %}
    {% set overflow_count = (plans|length - 14) if plans|length > 14 else 0 %}
    <div class="pl-grid">
      {% for plan in display_plans %}
      <div class="pl-item">
        <div class="pl-name">{{ plan.pl_name or plan.mavat_name or "תכנית ללא שם" }}</div>
        <div class="pl-meta">{{ plan.pl_number }}{% if plan.date_display %} · {{ plan.date_display }}{% endif %}</div>
        <div class="pl-badges">
          {% if plan.plan_type_order == 1 %}<span class="badge b-local">מקומית</span>
          {% elif plan.plan_type_order == 2 %}<span class="badge b-district">מחוזית</span>
          {% else %}<span class="badge b-national">ארצית</span>{% endif %}
          {% if plan.status_display %}
            {% if "מאושר" in plan.status_display or "אושר" in plan.status_display %}
              <span class="badge b-approved">מאושרת</span>
            {% elif "הפקד" in plan.status_display %}
              <span class="badge b-deposit">בהפקדה</span>
            {% elif "בוטל" in plan.status_display %}
              <span class="badge b-other">בוטלה</span>
            {% elif "אחסון" in plan.status_display or "ארכיב" in plan.status_display %}
              <span class="badge b-other">ארכיב</span>
            {% else %}
              <span class="badge b-other">{{ plan.status_display[:14] }}</span>
            {% endif %}
          {% endif %}
        </div>
      </div>
      {% endfor %}
    </div>
    {% if overflow_count > 0 %}
    <div class="pl-more">ועוד {{ overflow_count }} תכניות נוספות</div>
    {% endif %}
  </div>

  <div class="sfooter sfooter-dk">
    <div class="flogo">kark<span class="ga">A</span>i</div>
    <div class="fdate">{{ created_at }}</div>
  </div>
</div>


<!-- ══ SLIDE 4: MARKET ══ -->
<div class="slide" id="slide-market">
  <div class="vdivider vd-gold" style="left:42%;"></div>

  <div class="mkt-left">
    <div class="micro">נתוני שוק</div>
    <div class="hl"></div>
    <div class="mkt-title">מחירי</div>
    <div class="mkt-title">נדל"ן</div>

    {% if re %}
    <div class="mkt-stat" style="margin-top:14px;">
      <div class="mkt-lbl">ממוצע · החלקה</div>
      {% if re.parcel_3y %}<div class="mkt-val">₪{{ "{:,.0f}".format(re.parcel_3y) }}</div>
      {% else %}<div class="mkt-val" style="color:var(--muted);">—</div>{% endif %}
      <div class="mkt-sub">למ"ר · ממוצע 3 שנים</div>
    </div>
    <div class="mkt-stat">
      <div class="mkt-lbl">ממוצע · שכונה</div>
      {% if re.neighborhood_3y %}<div class="mkt-val">₪{{ "{:,.0f}".format(re.neighborhood_3y) }}</div>
      {% else %}<div class="mkt-val" style="color:var(--muted);">—</div>{% endif %}
      <div class="mkt-sub">למ"ר · ממוצע 3 שנים</div>
    </div>
    <div class="mkt-stat last">
      <div class="mkt-lbl">ממוצע · עיר</div>
      {% if re.settlement_3y %}<div class="mkt-val">₪{{ "{:,.0f}".format(re.settlement_3y) }}</div>
      {% else %}<div class="mkt-val" style="color:var(--muted);">—</div>{% endif %}
      <div class="mkt-sub">למ"ר · ממוצע 3 שנים</div>
    </div>
    <div class="mkt-trend">
      {% if re.trend_pct is not none %}
        {% if re.trend_direction == "up" %}
        <div class="trend-num trend-up">▲ {{ "{:+.0f}%".format(re.trend_pct) }}</div>
        {% elif re.trend_direction == "down" %}
        <div class="trend-num trend-down">▼ {{ "{:+.0f}%".format(re.trend_pct) }}</div>
        {% else %}
        <div class="trend-num trend-flat">→ {{ "{:+.0f}%".format(re.trend_pct) }}</div>
        {% endif %}
      {% else %}
        <div class="trend-num trend-flat">—</div>
      {% endif %}
      <div class="trend-lbl">מגמת מחירים · 5 שנים</div>
    </div>
    {% else %}
    <div style="color:var(--muted);font-family:'Heebo',sans-serif;font-size:12px;margin-top:16px;">נתוני שוק לא זמינים</div>
    {% endif %}
  </div>

  <div class="mkt-right">
    <div class="micro" style="color:var(--ivory);opacity:.5;">השוואת מחירים</div>
    <div class="hl"></div>
    <div class="mkt-compare-title">טבלת מחירים למ"ר</div>
    <table class="mkt-table">
      <thead><tr>
        <th>אזור</th><th>שנה אחרונה</th><th>3 שנים</th><th>5 שנים</th>
      </tr></thead>
      <tbody>
        <tr>
          <td><strong>החלקה</strong></td>
          <td class="{% if not re or not re.parcel_1y %}mkt-null{% endif %}">{% if re and re.parcel_1y %}₪{{ "{:,.0f}".format(re.parcel_1y) }}{% else %}—{% endif %}</td>
          <td class="{% if not re or not re.parcel_3y %}mkt-null{% endif %}">{% if re and re.parcel_3y %}₪{{ "{:,.0f}".format(re.parcel_3y) }}{% else %}—{% endif %}</td>
          <td class="{% if not re or not re.parcel_5y %}mkt-null{% endif %}">{% if re and re.parcel_5y %}₪{{ "{:,.0f}".format(re.parcel_5y) }}{% else %}—{% endif %}</td>
        </tr>
        <tr>
          <td><strong>שכונה</strong></td>
          <td class="{% if not re or not re.neighborhood_1y %}mkt-null{% endif %}">{% if re and re.neighborhood_1y %}₪{{ "{:,.0f}".format(re.neighborhood_1y) }}{% else %}—{% endif %}</td>
          <td class="{% if not re or not re.neighborhood_3y %}mkt-null{% endif %}">{% if re and re.neighborhood_3y %}₪{{ "{:,.0f}".format(re.neighborhood_3y) }}{% else %}—{% endif %}</td>
          <td class="{% if not re or not re.neighborhood_5y %}mkt-null{% endif %}">{% if re and re.neighborhood_5y %}₪{{ "{:,.0f}".format(re.neighborhood_5y) }}{% else %}—{% endif %}</td>
        </tr>
        <tr>
          <td><strong>עיר</strong></td>
          <td class="{% if not re or not re.settlement_1y %}mkt-null{% endif %}">{% if re and re.settlement_1y %}₪{{ "{:,.0f}".format(re.settlement_1y) }}{% else %}—{% endif %}</td>
          <td class="{% if not re or not re.settlement_3y %}mkt-null{% endif %}">{% if re and re.settlement_3y %}₪{{ "{:,.0f}".format(re.settlement_3y) }}{% else %}—{% endif %}</td>
          <td class="{% if not re or not re.settlement_5y %}mkt-null{% endif %}">{% if re and re.settlement_5y %}₪{{ "{:,.0f}".format(re.settlement_5y) }}{% else %}—{% endif %}</td>
        </tr>
      </tbody>
    </table>
    <div class="mkt-note">{% if re %}מבוסס על {{ re.parcel_deal_count }} עסקאות בחלקה · {{ re.neighborhood_deal_count }} בשכונה{% endif %}</div>
  </div>

  <div class="sfooter sfooter-dk">
    <div class="flogo">kark<span class="ga">A</span>i</div>
    <div class="fdate">{{ created_at }}</div>
  </div>
</div>


<!-- ══ SLIDE 5: AI ══ -->
<div class="slide" id="slide-ai">
  <div class="ai-inner">
    <div class="micro-dk">ניתוח תכנוני</div>
    <div class="hl" style="background:var(--green-800);"></div>
    <div class="ai-page-title">kark<span class="ga">A</span>i</div>
    <div class="ai-subtitle">ניתוח מבוסס בינה מלאכותית</div>

    {% if ai_analysis %}
    <div class="ai-box">
      <div class="ai-box-micro"><span class="micro-dk">ניתוח AI</span></div>
      <div class="ai-box-hl"></div>
      <div class="ai-text">{{ ai_analysis }}</div>
    </div>
    {% endif %}

    <div class="ai-disclaimer">
      <div class="ai-disclaimer-text">המידע בדוח זה מוצג לצרכי אינפורמציה בלבד ואינו מהווה ייעוץ משפטי, תכנוני, או השקעתי. הנתונים התכנוניים מקורם ב‑iplan.gov.il וב‑govmap.gov.il ועשויים שלא לשקף שינויים אחרונים.</div>
    </div>
  </div>

  <div class="sfooter sfooter-lt">
    <div class="flogo-dk">kark<span class="ga">A</span>i</div>
    <div class="fdate" style="color:var(--body-warm);">{{ created_at }} · govmap.gov.il · iplan.gov.il</div>
  </div>
</div>

</body>
</html>
